{
  "name": "agentic-order-service-ui",
  "version": "1.0.0",
  "description": "Independent administration frontend for Agentic Order Service",
  "scripts": {
    "api:generate": "openapi-typescript api/openapi.json -o src/shared/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "type": "module",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "private": true,
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
