{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Collection"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "vite.e2e.config.ts",
    "e2e"
  ]
}
